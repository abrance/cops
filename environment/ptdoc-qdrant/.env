# ptdoc 知识库组件的非敏感期望状态（随仓库提交）
#
# 敏感信息不要写在这里。本组件无密钥，故没有 /opt/cops/secrets/ptdoc-qdrant.env。

# 镜像源：gateway 走仓库约定镜像源 ghcr.chenby.cn（ghcr.io 回源 GitHub CDN 常超时，
# 云主机上直连 ghcr.io 会卡在 "Pulling fs layer"）；qdrant 官方镜像走 docker.io，
# 云主机 /etc/docker/daemon.json 已配置腾讯云内网 registry-mirror 加速。
#
# 注意 tag 格式：qdrant 上游用 v 前缀（v1.19.1），gateway 上游不带 v（1.0.6）。
QDRANT_IMAGE=docker.io/qdrant/qdrant
QDRANT_IMAGE_TAG=v1.19.1
GATEWAY_IMAGE=ghcr.chenby.cn/abrance/ptdoc-qdrant-gateway
GATEWAY_IMAGE_TAG=1.0.7

# 网关监听端口（只绑宿主机回环地址，公网入口见 compose.yaml 注释）
GATEWAY_PORT=6335
