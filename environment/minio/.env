# minio 的非敏感期望状态（随仓库提交）
#
# 敏感信息不要写在这里：root 用户名与口令走 SECRET_ENV + GitHub Secrets，
# 由 CI 下发到 /opt/cops/secrets/minio.env，再由 scripts/deploy-k8s.sh 变成
# k8s Secret minio-secrets 注入容器（见 app.conf 的注释与 README「k8s 部署模式」）。
#
# 数据不在集群卷里，而在宿主机的 hostPath 目录（见下面的 HOSTPATH_DATA 与 k8s.yaml）。

# 镜像源：cloud3 直连 docker.io（实测 6.9–7.9 MB/s，见 docs/cloud3.md 第五节），
# 所以 hosts.yaml 的 cloud3.registries 里必须包含 docker.io。
#
# 这里 pin 的是**迁移前正在跑的同一个 tag**（bitnamilegacy/minio:2025.7.23-debian-12-r5）：
# 本次变更只动命名空间与存储位置，不同时动版本，少一个变量。注意 bitnamilegacy 是
# Bitnami 的 legacy 镜像库，有被下架的先例，换官方 minio/minio 是后续独立的一件事。
MINIO_IMAGE=docker.io/bitnamilegacy/minio
MINIO_IMAGE_TAG=2025.7.23-debian-12-r5

# 端口：API 9000、控制台 9001（k8s.yaml 同时用作 Service 端口、容器端口与探针端口）
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001

# 宿主机上的数据目录（hostPath）。单节点 k3s 用 hostPath 最直接，也避免 PVC 二次搬迁。
# 目录由 k8s.yaml 的 hostPath.type=DirectoryOrCreate 建出来，属主由 initContainer 修
# （hostPath 不受 fsGroup 管辖，所以必须显式 chown，见 k8s.yaml 注释）。
HOSTPATH_DATA=/opt/minio/data

# 容器内运行 minio 的 uid/gid（bitnami 镜像默认 1001）。initContainer 按这个值 chown。
MINIO_FS_UID=1001

# 密钥对象名必须是 <APP_NAME>-secrets，deploy-k8s.sh 按这条规则创建。
MINIO_SECRET_NAME=minio-secrets

# 公网入口域名：沿用迁移前的两条（sslip.io 的 IP 域名），访问地址不变。
# 一个子域名 = 两条 IngressRoute（web 跳转 + websecure 带 tls），见 k8s.yaml。
PUBLIC_API_HOST=minio.186.244.201.55.sslip.io
PUBLIC_CONSOLE_HOST=minio-console.186.244.201.55.sslip.io

# 资源上限：与迁移前一致（申请 100m/256Mi，上限 500m/512Mi）
MINIO_CPU_LIMIT=500m
MINIO_MEM_LIMIT=512Mi
