# mysql8 的非敏感期望状态（随仓库提交）
#
# 敏感信息不要写在这里：root 口令走 SECRET_ENV + GitHub Secrets，由 CI 下发到
# /opt/cops/secrets/mysql8.env，再由 scripts/deploy-k8s.sh 变成 k8s Secret
# mysql8-secrets 注入容器（见 app.conf 与 README「k8s 部署模式」）。
#
# 数据不在集群卷里，而在宿主机的 hostPath 目录（见 HOSTPATH_DATA 与 k8s.yaml）。

# 镜像源：cloud3 直连 docker.io（实测 6.9–7.9 MB/s，见 docs/cloud3.md 第五节），
# 所以 hosts.yaml 的 cloud3.registries 里必须包含 docker.io。
# tag 与迁移前手工部署的实例一致，本次只换命名空间与存储位置。
MYSQL_IMAGE=docker.io/library/mysql
MYSQL_IMAGE_TAG=8.4

# 端口：k8s.yaml 同时用作 Service 端口、容器端口与 readinessProbe 的目标。
MYSQL_PORT=3306

# 宿主机上的数据目录（hostPath）。单节点 k3s 用 hostPath 最直接，也避免 PVC 二次搬迁。
# 目录由 k8s.yaml 的 hostPath.type=DirectoryOrCreate 建出来（属主 root），
# mysql 以非 root 运行、kubelet 又不对 hostPath 应用 fsGroup，所以属主由 initContainer 修。
HOSTPATH_DATA=/opt/mysql8/data

# 容器内运行 mysqld 的 uid/gid（mysql:8.4 官方镜像里 mysql 用户是 999）。initContainer 按这个值 chown。
MYSQL_FS_UID=999

# 密钥对象名必须是 <APP_NAME>-secrets，deploy-k8s.sh 按这条规则创建。
MYSQL_SECRET_NAME=mysql8-secrets

# 资源上限：与迁移前手工部署的实例一致（申请 100m/512Mi，上限 1 核/1Gi）。
MYSQL_CPU_LIMIT=1
MYSQL_MEM_LIMIT=1Gi
