# model-agent 的非敏感期望状态（随仓库提交）
#
# 敏感信息不要写在这里。运行期密钥放到云主机 /opt/cops/secrets/model-agent.env
# （权限 600，不入库），由 CI 下发，再由 scripts/deploy-k8s.sh 变成 k8s Secret
# 注入容器（见 app.conf 的 SECRET_ENV 与 README「k8s 部署模式」）。
#
# 源码仓库：https://github.com/abrance/pi-web —— 这是 pi-web 的 fork，平台代码在
# platform/ 目录（出厂能力基线、启动对账、镜像与冒烟、分叉登记表）。
# 产品与架构文档在 https://github.com/abrance/modelman 的 docs/platform.md。
#
# 镜像 tag 约定：<版本>-<提交短 sha>，永不覆盖。tag 由 agent-image workflow 的
# job summary 给出（打 agent/vX.Y.Z 触发）。

# 镜像源：cloud3 用 ghcr.io 直连（旧的 ghcr.chenby.cn 从 cloud3 访问会被 Cloudflare
# 拦成 403，见 docs/knowledge.md 第 6 节）。镜像是公开包，不需要凭据。
AGENT_IMAGE=ghcr.io/abrance/model-agent
AGENT_IMAGE_TAG=v0.1.1-48e2fe0

# 公网入口域名（k8s.yaml 的两条 IngressRoute 用它）：DNS 里 ai.xiaoyxq.top
# 已指向 cloud3，证书由 Traefik 的 ACME 自动签发。改域名只需改这一行，
# 同时要改下面的 AGENT_ALLOWED_HOSTS —— 两个地方必须是同一个值。
PUBLIC_HOST=ai.xiaoyxq.top

# 容器监听端口：镜像默认 30141，这里统一到集群惯用的 8080
# （同时用作 Service 端口、探针端口与 deploy-k8s.sh 的 K8S_HEALTH 端口）。
AGENT_PORT=8080

# 反代白名单：pi-web 默认只信任回环与已知主机，走 Traefik 反代时必须显式列出
# 对外域名，否则带域名的请求会被判成不可信（403）。
AGENT_ALLOWED_HOSTS=ai.xiaoyxq.top

# 会话闲置多久从内存里驱逐（毫秒）。会话文件在卷上，驱逐不等于丢数据；
# 调大是拿内存换响应速度。
AGENT_IDLE_TIMEOUT_MS=1800000

# 卷容量：组件目录（含基线装的 npm 依赖约 200 MB）+ 会话 + 物料
# （物料上限 2 GB、会话与物料保留 90 天，见 modelman 的 docs/platform.md P10）。
AGENT_PVC_SIZE=4Gi

# 密钥对象的名称约定：必须等于 <APP_NAME>-secrets，deploy-k8s.sh 按这个规则创建。
AGENT_SECRET_NAME=model-agent-secrets

# ── 资源上限 ─────────────────────────────────────────────────────────────────
#
# 首版估值，不是实测：镜像里是 Next.js 服务端 + 内嵌 Pi SDK，空载预计 300–500 MiB，
# 一次会话跑起来还会涨。上限对齐 model-ocr（1500Mi），留出会话的内存峰值。
# CPU 给 2 核：会话本身是等 provider 的网络 IO，不占 CPU，余量留给同机邻居。
AGENT_CPU_LIMIT=2
AGENT_MEM_LIMIT=1500Mi
