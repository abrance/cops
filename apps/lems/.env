# lems 的非敏感期望状态（随仓库提交）
#
# 敏感信息不要写在这里。如需运行期密钥，放到云主机
# /opt/cops/secrets/lems.env（权限 600，不入库），部署脚本会自动加载。

# 镜像源：ghcr.chenby.cn，tag 使用具体版本
#
# v1.0.65 起 SQLite 走 WAL（config.yaml 的 link 带 ?journal_mode=WAL）。
# 备份口径因此变了：**不能只拷 db.sqlite3 单文件**，见 docs/troubleshooting.md「lems 数据备份」。
LEMS_IMAGE=ghcr.chenby.cn/abrance/ems
# v1.0.80：s_db origin 白名单只给业务口径 + 数据面计数与漏读护栏（#179），
# 日频空态文案去掉「T+2」括注（#181）；同一 tag 的 CI 改动（#183–#186）只影响发布，
# 镜像内容与 v1.0.79 相同但 v1.0.79 发布失败无镜像。emsdevice 仍未变，维持 v1.0.64。
LEMS_IMAGE_TAG=v1.0.80
EMSDEVICE_IMAGE=ghcr.chenby.cn/abrance/emsdevice
EMSDEVICE_IMAGE_TAG=v1.0.64

# 端口与运行环境
# 容器时区。镜像内无 tzdata，compose 同时挂载宿主机 /usr/share/zoneinfo；
# 两者缺一不可，否则进程走 UTC，分时电价峰谷判定会偏 8 小时。
TZ=Asia/Shanghai
LEMS_PORT=11000
EMSDEVICE_PORT=1502
APP_PROFILE=prod

# 七牛云对象存储（现货日报图片）：非敏感，明文即可
# 密钥 QINIU_ACCESS_KEY / QINIU_SECRET_KEY 由 CI 下发到 /opt/cops/secrets/lems.env
#
# QINIU_DOMAIN 必须用 https（EMS 页面是 HTTPS，http 图片会被浏览器升级，
# 七牛 CDN 会回落 *.qbox.me 证书）；该 URL 在 GitHub Repository variables
# 的 LEMS_QINIU_DOMAIN 维护，部署时由 scripts/apply-repo-vars.sh 注入 .env。
QINIU_BUCKET=tos-me
QINIU_ZONE=z2

# 外部数据源/服务地址（URL/域名）在 GitHub Repository variables 维护：
#   LEMS_PRICE_SYNC_BASE_URL / LEMS_HOME_MARKET_GATEWAY_BASE / LEMS_GD_METRIC_URL /
#   LEMS_SPOT_REPORT_WECHAT_HOST / LEMS_FORECAST_BASE_URL / LEMS_QINIU_DOMAIN / LEMS_OCR_BASE_URL
# 部署时由 scripts/apply-repo-vars.sh 注入 .env；这里不再写死。

# 鉴权绕过：**当前关闭**（不设该变量 = 走正常鉴权，前端会显示登录页）。
#
# 2026-10-08 撤回：此前设成 admin 是因为新前端还没有登录页；现在登录页已上线
# （初始账号 admin / admin，登录后可在「管理 · 用户与权限」改密），不再需要它。
#
# 如需临时放开（内网调试/演示）：把下面这行取消注释，admin=读写全开、user=只读，
# 改完重新部署。**警告：ems.xiaoyxq.top 公网可达，admin 档位等于免密对外开放
# 管理员权限，用完立刻撤回。**
# AUTH_BYPASS_ROLE=admin

# OCR 文字识别服务：model-ocr 已迁到 cloud3 的 k3s（见 docs/cloud3-k8s-cd-design.md），
# 改走公网入口，证书由 Traefik 自动签发；共享网络方案已废弃并清理。
# 口径变化：这条链路跨公网且不启用鉴权（迁移时明确接受的取舍，见设计稿第 8 节）；
# 要收敛就在 model-ocr 侧启用 AUTH_TOKEN 并在这里带上。
OCR_TIMEOUT_SECONDS=60

# emsdevice 模拟数据参数
EMSDEVICE_MOCK=live
EMSDEVICE_MOCK_INTERVAL=1s
EMSDEVICE_MOCK_SOC=80
EMSDEVICE_MOCK_POWER=5
