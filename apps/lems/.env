# lems 的非敏感期望状态（随仓库提交）
#
# 敏感信息不要写在这里。如需运行期密钥，放到云主机
# /opt/cops/secrets/lems.env（权限 600，不入库），部署脚本会自动加载。

# 镜像：公开 GHCR 包，服务器可匿名拉取
LEMS_IMAGE=ghcr.io/abrance/ems
LEMS_IMAGE_TAG=v1.0.8
EMSDEVICE_IMAGE=ghcr.io/abrance/emsdevice
EMSDEVICE_IMAGE_TAG=v1.0.5

# 端口与运行环境
LEMS_PORT=11000
EMSDEVICE_PORT=1502
APP_PROFILE=prod

# emsdevice 模拟数据参数
EMSDEVICE_MOCK=live
EMSDEVICE_MOCK_INTERVAL=1s
EMSDEVICE_MOCK_SOC=80
EMSDEVICE_MOCK_POWER=5
