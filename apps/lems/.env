# lems 的非敏感期望状态（随仓库提交）
#
# 敏感信息不要写在这里。如需运行期密钥，放到云主机
# /opt/cops/secrets/lems.env（权限 600，不入库），部署脚本会自动加载。

# 镜像源：ghcr.chenby.cn，tag 使用具体版本
LEMS_IMAGE=ghcr.chenby.cn/abrance/ems
LEMS_IMAGE_TAG=v1.0.10
EMSDEVICE_IMAGE=ghcr.chenby.cn/abrance/emsdevice
EMSDEVICE_IMAGE_TAG=v1.0.5

# 端口与运行环境
LEMS_PORT=11000
EMSDEVICE_PORT=1502
APP_PROFILE=prod

# 七牛云对象存储（现货日报图片）：非敏感，明文即可
# 密钥 QINIU_ACCESS_KEY / QINIU_SECRET_KEY 由 CI 下发到 /opt/cops/secrets/lems.env
QINIU_BUCKET=tos-me
QINIU_DOMAIN=http://file.xiaoyxq.top
QINIU_ZONE=z2

# emsdevice 模拟数据参数
EMSDEVICE_MOCK=live
EMSDEVICE_MOCK_INTERVAL=1s
EMSDEVICE_MOCK_SOC=80
EMSDEVICE_MOCK_POWER=5
