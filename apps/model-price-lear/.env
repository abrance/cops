# model-price-lear 的非敏感期望状态（随仓库提交）
#
# 敏感信息不要写在这里。如需运行期密钥，放到云主机
# /opt/cops/secrets/model-price-lear.env（权限 600，不入库），部署脚本会自动加载。
#
# 源码仓库：https://github.com/abrance/modelman
# 镜像 tag 约定：<版本>-<提交短 sha>，永不覆盖（与 model-price-gbm 一致）。
#
# 服务是什么：广东现货小时电价 LEAR（LASSO 自回归）预测。POST /v1/price-forecast，
# 入参 days[]（升序完整日，最后一天为锚点，<=60 天）+ target，返回 point 与
# quantiles(0.1/0.5/0.9)，horizon 上限 14 天。predictor 状态是几 KB 的 JSON
# （LASSO 系数 + 标准化参数），随镜像交付；推理只用 numpy，运行期不联网、无 PVC。

# 镜像源：cloud3 用 ghcr.io 直连（ghcr.chenby.cn 从 cloud3 访问会被 Cloudflare 拦成 403）。
MODEL_PRICE_LEAR_IMAGE=ghcr.io/abrance/modelman-price-lear
# tag 来自 modelman 的 release price-lear/v0.1.0（release job summary 给出）：
# 版本号取自 services/price-lear/src/build_info.py 的 VERSION，短 sha 为 7 位。
MODEL_PRICE_LEAR_IMAGE_TAG=v0.1.0-70fdf1e

# 端口：k8s 里指容器监听端口（镜像固定 8080），同时用作 Service 端口与探针端口。
MODEL_PRICE_LEAR_PORT=8080

# ── 资源 ─────────────────────────────────────────────────────────────────────
#
# 推理只用 numpy：状态 JSON 几 KB，单请求 ~50ms，常驻内存远小于 GBM 那一档。
# smoke.sh 用 --memory=512m 跑通；这里 512Mi 上限正好对齐，request 给很小。
# request 刻意写小：别的单元只写 limits，k8s 把 request 默认成 limit，
# 16 核 node 已被 request 掉十多个核，这里按 limit 申请会 Pending。
MODEL_PRICE_LEAR_MEM_LIMIT=512Mi
MODEL_PRICE_LEAR_MEM_REQUEST=128Mi
MODEL_PRICE_LEAR_CPU_LIMIT=1
MODEL_PRICE_LEAR_CPU_REQUEST=100m

# ── 暴露方式与鉴权 ───────────────────────────────────────────────────────────
#
# **只做 ClusterIP，不开公网入口**：调用方是同一集群里的 lems（ems 后端），
# 走 model-price-lear.cops.svc.cluster.local:8080。要对外时再在 k8s.yaml 补两条
# IngressRoute（拆 web / websecure，见 model-forecast 的注释）并给 .env 加 PUBLIC_HOST。
#
# AUTH_TOKEN 不设 = 不鉴权：服务只在集群内可达，与 model-price-gbm 口径一致。
