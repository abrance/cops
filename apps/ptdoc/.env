# ptdoc 的非敏感期望状态（随仓库提交）
#
# 敏感信息不要写在这里。运行期密钥 PTDOC_DATA_KEY 放在云主机
# /opt/cops/secrets/ptdoc.env（权限 600，不入库），部署脚本会自动加载。

# 镜像源：ghcr.chenby.cn，tag 使用具体版本
PTDOC_IMAGE=ghcr.chenby.cn/abrance/ptdoc
PTDOC_IMAGE_TAG=v1.0.8

# 端口：宿主机端口与容器内预览端口
PTDOC_PORT=4173
PREVIEW_PORT=4173

# 登录会话有效期（天）
PTDOC_SESSION_TTL_DAYS=7

# 说明：VITE_SITE_TITLE / VITE_DEFAULT_DOC 只在构建镜像时内联进前端产物
#（见 src/config.ts 与 scripts/build-site.ts），运行期不再读取，故不在此声明。
