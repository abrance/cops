# litellm 的非敏感期望状态（随仓库提交）
#
# 敏感信息不放这里：LITELLM_MASTER_KEY / LITELLM_SALT_KEY / LITELLM_DB_PASSWORD
# 走 cloud2 的 /opt/cops/secrets/litellm.env（权限 600，不入库），部署脚本自动加载。

# 镜像：cloud2（default 主机）实测 ghcr.io 直连可达；用不可变 release tag，不用 latest/main-stable
# v1.110.3：2026-11-24 release
LITELLM_IMAGE=ghcr.io/berriai/litellm
LITELLM_IMAGE_TAG=v1.110.3

# 自己的结果库；与 litellm 镜像同为 docker.io 官方镜像
LITELLM_DB_IMAGE=postgres
LITELLM_DB_IMAGE_TAG=16-alpine

# 宿主机回环端口；公网域名由宿主机 Traefik 反代（反代规则不在本仓库）
LITELLM_PORT=4000

# 容器日志级别：排障时改成 DEBUG 再部署
LITELLM_LOG=INFO

TZ=Asia/Shanghai
