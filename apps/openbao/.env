# openbao 的非敏感期望状态（随仓库提交）
#
# 部署方式与其它 k8s 单元不同：本单元期望状态 = 本文件外的两个产物
#   - 本目录 values.yaml → CI helm template 渲染 chart（openbao/openbao）
#   - 本目录 k8s.yaml → render-k8s.py 渲染（命名空间 + 公网入口）
# 两份输出拼成 rendered.yaml 由 deploy-k8s.sh apply（见 app.conf 与 deploy.yml）。
#
# 敏感信息不要写在这里。init 生成 root token / unseal keys 是一次性人工动作，
# 保管在云主机 /opt/cops/secrets/openbao.env（权限 600，不入库），见 docs/cloud3.md。

# 公网入口域名（k8s.yaml 的两条 IngressRoute 用它）：DNS 里 bao.xiaoyxq.top
# 已指向 cloud3，证书由 Traefik ACME 自动签发。
PUBLIC_HOST=bao.xiaoyxq.top

# 镜像声明只用于 registry 守卫（scripts/check-registries.sh 只认 *_IMAGE= 的键），
# 实际拉取由 values.yaml + chart appVersion 决定，这里必须与之一致才能兜住改动。
# chart 0.30.2 → appVersion v2.7.1 → 镜像 quay.io/openbao/openbao:2.7.1。
OPENBAO_IMAGE=quay.io/openbao/openbao
OPENBAO_IMAGE_TAG=2.7.1