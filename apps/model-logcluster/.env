# model-logcluster 的非敏感期望状态（随仓库提交）
#
# 敏感信息不要写在这里。如需运行期密钥，放到云主机
# /opt/cops/secrets/model-logcluster.env（权限 600，不入库），部署脚本会自动加载。
#
# 源码仓库：https://github.com/abrance/modelman
# 镜像 tag 约定：<版本>-<提交短 sha>，永不覆盖。改 tag 前先确认该 tag 已在
# modelman 的 release job summary 中给出。
#
# 注意：这是本仓库第一个**有状态**的单元 —— 模板树落在命名卷里，
#       回滚镜像不会回滚状态，见文件末尾「状态与回滚」。

# 镜像源：ghcr.chenby.cn，tag 使用具体版本
MODEL_LOGCLUSTER_IMAGE=ghcr.chenby.cn/abrance/modelman-logcluster
# 镜像 tag 来自 modelman 的 release logcluster/v0.1.0（release job summary 给出）
# 格式为 v0.1.0-<7 位提交短 sha>。
# 镜像不存在时部署会停在「拉取镜像」，升级 tag 前先确认新 tag 已在镜像站可拉取。
MODEL_LOGCLUSTER_IMAGE_TAG=v0.1.1-4c4f4e1

# 端口：模型服务统一使用 91xx 段（11000/1502/4173/8081/9090 已被占用）
MODEL_LOGCLUSTER_PORT=9103

# ── 聚类参数 ─────────────────────────────────────────────────────────────────
#
# 这几个值是状态文件的一部分：改动后旧状态会被判定为不兼容，服务拒绝加载
# （/readyz 503、容器 unhealthy），部署会停在健康门。要改参数就得先清掉旧状态。

# 相似度阈值，越低越容易把不同日志合并进一个模板
MODEL_LOGCLUSTER_SIM_TH=0.4
# Drain3 树的深度，必须 >= 3
MODEL_LOGCLUSTER_DEPTH=4
MODEL_LOGCLUSTER_MAX_CHILDREN=100
# 含数字的 token 默认当作参数（IP、UUID、百分比因此不需要额外规则）
MODEL_LOGCLUSTER_PARAMETRIZE_NUMERIC=true
# 额外脱敏规则，逗号分隔，可选 ip/uuid/hex/path；默认空
MODEL_LOGCLUSTER_MASK_RULES=

# 模板没有变化时的落盘间隔（分钟）。模板一变化就立即落盘，不受这个值影响，
# 所以实际写入频率由日志的新颖程度决定。
MODEL_LOGCLUSTER_SNAPSHOT_INTERVAL_MINUTES=5

# ── 并发与输入上限 ───────────────────────────────────────────────────────────
#
# 云主机 4 核且与 lems/ptdoc/qdrant/postgres/model-ocr 共享，
# 这几个值必须显式设置，不能留给运行时按核数推导。
MODEL_LOGCLUSTER_MAX_CONCURRENCY=2
MODEL_LOGCLUSTER_QUEUE_TIMEOUT_SECS=30
# uvicorn 连接级上限，超出直接 503，避免排队无界
MODEL_LOGCLUSTER_LIMIT_CONCURRENCY=8

# 单请求行数 / 单行字符数 / 请求体字节数。超限返回 400。
MODEL_LOGCLUSTER_MAX_LINES=2000
MODEL_LOGCLUSTER_MAX_LINE_CHARS=8192
MODEL_LOGCLUSTER_MAX_BYTES=8388608

# 日志级别
MODEL_LOGCLUSTER_LOG_LEVEL=info

# ── 资源上限 ─────────────────────────────────────────────────────────────────
#
# 实测常驻内存约 40 MiB（11 个模板 / 24 行），这里是兜底而不是预期用量；
# 模板树会随累积增长，所以留了 6 倍余量。CPU 给 1.5 核：单次请求是毫秒级，
# MAX_CONCURRENCY=2 也用不满 2 核，余量留给同机邻居。
MODEL_LOGCLUSTER_CPU_LIMIT=1.5
MODEL_LOGCLUSTER_MEM_LIMIT=256M

# ── 暴露方式 ─────────────────────────────────────────────────────────────────
#
# 本单元只绑回环（127.0.0.1:9103），公网入口由宿主机上的 dockpanel/traefik
# 转发，不在本仓库范围。
#
# 鉴权口径：**当前不启用**，与 model-ocr 同（modelman 仓库 docs/design.md D16）。
#
# 代价比 model-ocr 重，值得记在这里：/cluster 是**写**接口 —— 入口对外可达时，
# 任何人都能往模板树里埋数据，而模板污染不会自动恢复，只能清空状态卷重学
# （代价是丢掉已累积的模板，见本文件末尾「状态与回滚」）。
#
# 要收敛时改三处即可，**不需要改服务代码**（服务端 token 逻辑已实现并有测试）：
#   1. .github/workflows/deploy.yml 的密钥分发映射里加一行 MODEL_LOGCLUSTER_AUTH_TOKEN
#   2. app.conf 的 SECRET_ENV 改成 "AUTH_TOKEN"，并在 REQUIRED_ENV 里同步声明
#   3. token 写入云主机 /opt/cops/secrets/model-logcluster.env（权限 600）
AUTH_TOKEN=

# ── 状态与回滚 ───────────────────────────────────────────────────────────────
#
# 状态位置：命名卷 model-logcluster_state 挂在容器的 /app/state。
# 确认实际卷名：
#   docker volume ls --filter name=model-logcluster
# 看一眼状态文件（schema 版本、参数、模板数）：
#   docker run --rm -v model-logcluster_state:/s alpine cat /s/drain_state.json
#
# 回滚旧 tag 时：状态里的 schema 版本与聚类参数必须与旧镜像一致。不一致时服务
# 会降级（/readyz 503、容器 unhealthy）并且**不覆盖**旧状态，部署停在
# 「等待容器健康」。这是刻意的：宁可让回滚失败，也不要拿旧参数去解释新模板。
#
# 要回到可用状态，先备份再清空状态（会丢掉已累积的模板，簇 ID 从 1 重新开始）：
#   docker run --rm -v model-logcluster_state:/s alpine \
#     tar cz -C /s . > /tmp/logcluster-state-$(date +%F).tgz
#   cd /opt/cops/apps/model-logcluster
#   docker compose --env-file .env stop
#   docker volume rm model-logcluster_state
#   docker compose --env-file .env up -d
