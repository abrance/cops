# sub2api 的非敏感期望状态（随仓库提交）
#
# 敏感信息不放这里：POSTGRES_PASSWORD / REDIS_PASSWORD / JWT_SECRET /
# TOTP_ENCRYPTION_KEY / ADMIN_PASSWORD 走 cloud2 的 /opt/cops/secrets/sub2api.env
# （权限 600，不入库），部署脚本自动加载。

# 镜像：docker.io（default 主机白名单内）。上游 docker.io 只有 latest，
# 固定到当前 digest 以便可复现；升级时 docker pull 后看
# `docker image inspect --format '{{index .RepoDigests 0}}'` 换 digest。
SUB2API_IMAGE=weishaw/sub2api
# 0.2.26（2026-11-28）：修复 Chat/Responses/Anthropic 协议互转的工具调用、截断收尾与
# 用量统计；新增「向用户显示实际响应模型」开关。破坏性：Chat→Responses length 截断改
# 以 response.incomplete 收尾。
SUB2API_IMAGE_TAG=0.2.26

# 官方 compose 用 postgres:18-alpine + redis:8-alpine
SUB2API_DB_IMAGE=postgres
SUB2API_DB_IMAGE_TAG=18-alpine
SUB2API_REDIS_IMAGE=redis
SUB2API_REDIS_IMAGE_TAG=8-alpine

# 运行模式：standard（完整 SaaS，含分组倍率/余额/充值）或 simple（自用，跳过计费）
SUB2API_RUN_MODE=standard

# 宿主机回环端口；公网域名由宿主机 Traefik 反代（反代规则不在本仓库）
SUB2API_PORT=8080

# 管理员登录邮箱（登录用户名；不填则首次启动随机生成并打印在日志里）
ADMIN_EMAIL=xiaoy@xiaoyxq.top

# 在线更新/价格表需要访问 GitHub；cloud2 直连不稳，走本机已有的出口代理（gdpm-proxy 白名单代理）
UPDATE_PROXY_URL=http://10.193.0.9:3128

TZ=Asia/Shanghai
