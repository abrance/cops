# gdpm 日采集的非敏感期望状态（随仓库提交）
#
# 只跑一个 k8s CronJob，没有常驻服务。镜像由 ems 仓库的 tag 发布产出
# （.github/workflows/docker-publish-gdpm.yml → ghcr.io/abrance/ems-gdpm）。
GDPM_IMAGE=ghcr.io/abrance/ems-gdpm
GDPM_IMAGE_TAG=v1.0.78

# 采集时点（Asia/Shanghai 本地时间，k8s ≥1.27 的 timeZone 字段生效；cloud3 是 v1.37）。
# 为什么 08:20：日前出清价在前一晚发布、实时价按 T+2 补，早上跑一次能同时拿到
# 「今天的日前」和「前天补齐的实时」。采集是整表重拉 + 幂等 upsert（ON CONFLICT DO UPDATE），
# 哪天漏跑，第二天的重拉会自动补齐，所以不需要一天多次。
GDPM_SCHEDULE=20 8 * * *
GDPM_TIMEZONE=Asia/Shanghai

# CronJob 与 lems 共用同一块数据盘（PVC lems-data，由 apps/lems-cloud3 创建，本单元只引用）
LEMS_DATA_CLAIM=lems-data
GDPM_DB=/app/out/db.sqlite3

# 采集出口：cloud3 出口在美国，pm.gd.csg.cn 对境外来源不回包（TLS 通、响应体恒 0 字节），
# 必须走 cloud2 上的白名单代理（apps/gdpm-proxy，easytier mesh 10.193.0.9:3128）。
PROXY_URL=http://10.193.0.9:3128
# 只给这一个 CronJob 用，范围比 lems 收窄：它只访问源站与集群 DNS。
NO_PROXY=localhost,127.0.0.1,.svc,.cluster.local,10.0.0.0/8,10.42.0.0/16
