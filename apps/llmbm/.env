# llmbm 的非敏感期望状态（随仓库提交）。源码仓库：https://github.com/abrance/llmbm
#
# 敏感信息不放这里：v0.2 起唯一的运行期密钥是结果库 DSN（LLMBM_PG_URL），
# 它手工建在命名空间 Secret `llmbm-pg` 里，见 app.conf 末尾说明。

# 镜像源：cloud3 只能直连 ghcr.io（ghcr.chenby.cn 会被 Cloudflare 拦 403）。
# tag 用 release tag（不可变），latest 只作参考。
#
# 该包在 GHCR 上为 **public**（2026-11-13 起），kubelet 用匿名 token 拉取，
# 所以 k8s.yaml 里不再挂 imagePullSecret `ghcr-pull`（命名空间里那个 Secret 可留可删）。
# 主机上手工预置镜像不再是必需步骤。
LLMBM_IMAGE=ghcr.io/abrance/llmbm
# v0.2.0：结果库改 Postgres（apps/pg 单元的 llmbm 库），保留 SQLite 作回滚后端。
LLMBM_IMAGE_TAG=v0.2.0

# 容器监听端口（镜像固定 8787，同时是 Service 端口与探针端口）
LLMBM_PORT=8787

# SQLite 库所在卷容量。v0.2 起结果库在 PG（apps/pg 的 llmbm 库），这张卷只作为
# 历史数据来源与回滚后端保留，服务端不再写入（清掉 LLMBM_PG_URL 才回落）。
# 库只存社区分享/结果索引，实测单条 KB 级、无大对象；2Gi 留足余量（含 WAL）。
LLMBM_DATA_SIZE=2Gi

# 公网入口：DNS 里没有 llmbm.xiaoyxq.top 的 A 记录，用 sslip.io 直接解析到 cloud3
# 公网 IP（与 environment/minio 同一套做法），无需人工加 DNS 就能签 Let's Encrypt。
# 将来加了 A 记录，把这里换成 llmbm.xiaoyxq.top 即可，其余对象不用动。
PUBLIC_HOST=llmbm.186.244.201.55.sslip.io

# 资源：实测依据见 PR 描述。服务端只做静态托管 + /api/health + /api/proxy 流式透传，
# 不含模型推理；请求延迟由上游网关主导（p50 620ms / p95 937ms），CPU 基本空转。
LLMBM_CPU_REQUEST=50m
LLMBM_MEM_REQUEST=128Mi
LLMBM_CPU_LIMIT=500m
LLMBM_MEM_LIMIT=512Mi

TZ=Asia/Shanghai
