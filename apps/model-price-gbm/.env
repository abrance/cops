# model-price-gbm 的非敏感期望状态（随仓库提交）
#
# 敏感信息不要写在这里。如需运行期密钥，放到云主机
# /opt/cops/secrets/model-price-gbm.env（权限 600，不入库），部署脚本会自动加载。
#
# 源码仓库：https://github.com/abrance/modelman
# 镜像 tag 约定：<版本>-<提交短 sha>，永不覆盖（与 model-jev / model-forecast 一致）。
#
# 服务是什么：广东现货小时电价 LightGBM 分位预测。POST /v1/price-forecast，
# 入参 days[]（升序完整日，最后一天为锚点，<=60 天）+ target，返回 point 与
# quantiles(0.1/0.5/0.9)，horizon 上限 14 天。权重随镜像交付（3 个 ~2.7 MB 的
# booster 文本），运行期不联网、不需要 PVC。

# 镜像源：cloud3 用 ghcr.io 直连（ghcr.chenby.cn 从 cloud3 访问会被 Cloudflare 拦成 403）。
MODEL_PRICE_GBM_IMAGE=ghcr.io/abrance/modelman-price-gbm
# tag 来自 modelman 的 release price-gbm/v0.1.0（release job summary 给出）：
# 版本号取自 services/price-gbm/src/build_info.py 的 VERSION，短 sha 为 7 位。
MODEL_PRICE_GBM_IMAGE_TAG=v0.1.1-70bf94b

# 端口：k8s 里指容器监听端口（镜像固定 8080），同时用作 Service 端口与探针端口。
MODEL_PRICE_GBM_PORT=8080

# ── 资源 ─────────────────────────────────────────────────────────────────────
#
# LightGBM 推理是毫秒级：3 个 booster 文本共 8.4 MB，加载后常驻几百 MB。
# smoke.sh 用 --memory=512m 跑通，所以 1Gi 上限留了一倍余量（特征构造按天展开）。
# request 刻意写小：别的单元只写 limits，k8s 把 request 默认成 limit，
# 16 核 node 已被 request 掉十多个核，这里按 limit 申请会 Pending。
MODEL_PRICE_GBM_MEM_LIMIT=1Gi
MODEL_PRICE_GBM_MEM_REQUEST=256Mi
MODEL_PRICE_GBM_CPU_LIMIT=2
MODEL_PRICE_GBM_CPU_REQUEST=100m

# ── 暴露方式与鉴权 ───────────────────────────────────────────────────────────
#
# **只做 ClusterIP，不开公网入口**：调用方是同一集群里的 lems（ems 后端），
# 走 model-price-gbm.cops.svc.cluster.local:8080 即可；开公网要额外加 DNS A 记录
# 并等 ACME 签发，收益为零。要对外时再在 k8s.yaml 补两条 IngressRoute
# （拆 web / websecure，见 model-forecast 的注释）并给 .env 加 PUBLIC_HOST。
#
# AUTH_TOKEN 不设 = 不鉴权：服务只在集群内可达，与 model-forecast/model-ocr 口径一致。
