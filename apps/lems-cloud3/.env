LEMS_IMAGE=ghcr.io/abrance/ems
LEMS_IMAGE_TAG=v1.0.69
LEMS_PORT=80
APP_PROFILE=prod
# emsdevice 与 ems 同仓同 tag 发布（ems/emsdevice 各自一条 workflow，tag 推送触发）。
# 注意：emsdevice 包的 v1.0.0 从未成功发布过（ghcr 上 404，最早可拉的是 v1.0.1），
# 所以这里跟 lems 用同一个 tag，避免指向一个拉不到的镜像。
EMSDEVICE_IMAGE=ghcr.io/abrance/emsdevice
EMSDEVICE_IMAGE_TAG=v1.0.56
EMSDEVICE_PORT=1502
EMSDEVICE_MOCK=live
EMSDEVICE_MOCK_INTERVAL=1s
EMSDEVICE_MOCK_SOC=80
EMSDEVICE_MOCK_POWER=5
TZ=Asia/Shanghai
QINIU_BUCKET=tos-me
# 必须 https：EMS 页面自身是 HTTPS，浏览器会把页面里的 http 图片请求自动升级成
# https（mixed content auto-upgrade）。写 http 时升级后七牛 CDN 会回落 *.qbox.me
# 证书，图片报 ERR_CERT_COMMON_NAME_INVALID。与 apps/lems/.env 的约定一致。
QINIU_DOMAIN=https://file.xiaoyxq.top
QINIU_ZONE=z2
OCR_BASE_URL=https://ocr.xiaoyxq.top
OCR_TIMEOUT_SECONDS=60
LEMS_DATA_SIZE=10Gi
PUBLIC_HOST=ems.xiaoyxq.top
