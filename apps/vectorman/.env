# vectorman 期望状态（k8s / k3s，非敏感变量随仓库提交）
#
# 源码仓库：https://github.com/abrance/vectorman
# 镜像：多功能镜像（一个 tag 出五件二进制 + 三份前端 dist），由 vectorman 的
#   release-image workflow 推送到 ghcr.io，tag = <版本>-<7 位短 sha>，永不覆盖。
#   只 bump 下面的 VECTORMAN_IMAGE_TAG 即可升级。
#
# 敏感信息不写这里：运行期密钥放云主机 /opt/cops/secrets/vectorman.env（600，不入库）。
#
# ── 组件与端口 ───────────────────────────────────────────────────────────────
#
# 三个 Deployment 共用一个镜像、三个入口命令：
#   gse-server  Agent RPC(7100) + 管理 HTTP(7101，托管 GSE 控制台前端)
#   dataserver  数据面 SQL(8081) + Prom(9090) + metrics(9091)；管理 HTTP 同 8081 端口托管数据面前端
#   console     桌面门户(7200) + metrics(7201)
#
# 端口规划 = 对外唯一入口矩阵（与 Service / IngressRoute 一一对应）：
#   Agent RPC:   vectorman.xiaoyxq.top:30710  -> NodePort 30710（不过 Traefik）
#   GSE 控制台:  https://vectorman.xiaoyxq.top  -> gse-server:7101
#   数据面前端:  https://dataserver.xiaoyxq.top  -> dataserver:8081
#   桌面门户:    https://console.xiaoyxq.top     -> console:7200
#
# ⚠️ 客户端（Agent）配置写「域名:30710」而不是「域名:7100」：
#    7100 只在集群内监听，对外只有 NodePort 30710。这是三个 Agent 迁移时
#    反复踩的同一个坑（见 docs/knowledge.md）。
#
# metrics 口（7102 / 9091 / 7201）不建 Service：当前无消费者。

VECTORMAN_IMAGE=ghcr.io/abrance/vectorman-server
# tag 来自 vectorman 的 release-image workflow（tag 约定 server/v<semver>），
# job summary 会给出实际镜像 tag。升级前确认新 tag 在 GHCR 可拉取。
# 回滚即把这一行改回上一个 tag。
VECTORMAN_IMAGE_TAG=v1.2.2-777e7b0

# ── 命名空间与对外域名 ───────────────────────────────────────────────────────
#
# 三个域名都在腾讯云 DNS 里 A 记录指向 cloud3（186.244.201.55），
# 证书由 k3s 自带 Traefik 的 ACME 自动签发。
# ⚠️ DNS 必须先生效再 apply：ACME HTTP-01 挑战要到得了 Traefik 才能签发。
PUBLIC_HOST_GSE=vectorman.xiaoyxq.top
PUBLIC_HOST_DATAPLANE=dataserver.xiaoyxq.top
PUBLIC_HOST_CONSOLE=console.xiaoyxq.top

# ── NodePort（给集群外的 Agent / CLI 用）────────────────────────────────────
#
# Agent RPC 走 30710：服务端只负责「IP:port 监听」，客户端写域名:port。
# 其余 NodePort 是同一套「直接打端口」的旁路入口，公网入口仍是上面的域名。
NODEPORT_RPC=30710
NODEPORT_GSE_HTTP=30711
NODEPORT_SQL=30881
NODEPORT_PROM=30990
NODEPORT_CONSOLE=30720

# ── 数据目录（hostPath）──────────────────────────────────────────────────────
#
# 单节点 k3s：数据直接落节点目录，不用 PVC（多节点时再换 local-path）。
# ⚠️ 删 Pod 不丢数据；删节点目录才会丢。备份就在这个路径下。
# state 目录是 sqlite / tsink / redb —— 三个进程各占一份，**忌双进程同时写**，
# 所以 Deployment 用 strategy: Recreate 而不是 RollingUpdate。
HOSTPATH_GSE_SERVER=/opt/vectorman-k8s/gse-server
HOSTPATH_DATASERVER=/opt/vectorman-k8s/dataserver
HOSTPATH_CONSOLE=/opt/vectorman-k8s/console

# ── 资源上限 ─────────────────────────────────────────────────────────────────
#
# cloud3 是单机 k3s，与 cops 的其他单元共享。这里是兜底，不是预期用量。
# dataserver 是重头（tsink + sqlite + redb），给的内存上限最大。
CPU_REQUEST_GSE=50m
MEM_REQUEST_GSE=64Mi
MEM_LIMIT_GSE=256Mi
CPU_REQUEST_DATASERVER=100m
MEM_REQUEST_DATASERVER=256Mi
MEM_LIMIT_DATASERVER=1Gi
CPU_REQUEST_CONSOLE=20m
MEM_REQUEST_CONSOLE=32Mi
MEM_LIMIT_CONSOLE=128Mi
