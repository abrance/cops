# vectorman 期望状态：非敏感变量，随仓库提交。
#
# 交付物是 GitHub Releases 上的 musl 静态二进制 tarball（公开可匿名下载）。
# native/deploy-native.sh 下载后校验 sha256，再用包内 install.sh 装成 systemd 服务。

# 交付产物：native 模式通用声明（CI 在 runner 侧下载并暂存到云主机）。
#
# 云主机直连 GitHub 带宽极差、release 资产实际不可用，故由 CI 下载校验后再上传；
# deploy-native.sh 优先使用暂存文件，缺失时才回退为主机下载。
# 回滚即把 URL 与 SHA256 改回上一个版本。
NATIVE_ARTIFACT_URL=https://github.com/abrance/vectorman/releases/download/v1.0.7/vectorman-1.0.7-linux-x86_64.tar.gz
NATIVE_ARTIFACT_SHA256=f9daa18aad85c3c83b319602df2917daadd4f97c0ffb89163dab9b43ee2b736e

# 安装根目录，对应 install.sh --dest
VECTORMAN_INSTALL_ROOT=/opt/vectorman

# 组件端口（实际监听由 conf/ 下的 TOML 决定，此处仅作记录）
VECTORMAN_PORT_GSE_RPC=7100
VECTORMAN_PORT_GSE_HTTP=7101
VECTORMAN_PORT_CONSOLE=7200
VECTORMAN_PORT_DATASERVER_SQL=8081
VECTORMAN_PORT_DATASERVER_PROM=9090
