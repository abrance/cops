# vikunja 的非敏感期望状态（随仓库提交）
#
# 敏感信息不要写在这里：DB 口令、session 签名密钥、S3 AK/SK 走 SECRET_ENV +
# GitHub Secrets，由 CI 下发到 /opt/cops/secrets/vikunja.env，再由
# scripts/deploy-k8s.sh 变成 k8s Secret vikunja-secrets 注入容器
# （见 app.conf 与 README「k8s 部署模式」）。
#
# 这个单元**无状态**：附件在 MinIO（environment/minio），数据在 MySQL
# （environment/mysql8），所以没有任何卷。回滚镜像不涉及数据。

# 镜像源：cloud3 直连 docker.io（实测 6.9–7.9 MB/s，见 docs/cloud3.md 第五节），
# 所以 hosts.yaml 的 cloud3.registries 里必须包含 docker.io。
# tag 与迁移前手工部署的运行版本一致；升级只在确认 changelog 后单独改这一行，
# 启动时会自动跑 DB migration（见 docs/cloud3.md 的 vikunja 一节）。
VIKUNJA_IMAGE=docker.io/vikunja/vikunja
VIKUNJA_IMAGE_TAG=2.7.0

# 端口：容器监听 3456（镜像默认），同时用作 Service 端口、探针端口与 IngressRoute 后端。
VIKUNJA_PORT=3456

# 公网入口域名：DNS 里 vikunja.xiaoyxq.top 已指向 cloud3，证书由 Traefik ACME 自动签发。
# 一个域名 = 两条 IngressRoute（web 跳转 + websecure 带 tls），见 k8s.yaml。
PUBLIC_HOST=vikunja.xiaoyxq.top
# vikunja 用它生成绝对地址（邮件、CalDAV、分享链接），必须与 PUBLIC_HOST 完全一致。
SERVICE_PUBLICURL=https://vikunja.xiaoyxq.top/

# 数据库：宿主是 environment/mysql8 的 Service（跨命名空间，用 FQDN）。
# 迁移前是 mysql.vikunja.svc.cluster.local:3306，差别只在命名空间。
VIKUNJA_DB_HOST=mysql.mysql8.svc.cluster.local:3306
VIKUNJA_DB_NAME=vikunja
VIKUNJA_DB_USER=vikunja

# 附件存储：environment/minio 的 Service（跨命名空间，用 FQDN）。
# 对象 key 带 files.basepath 前缀，即 files/<附件 id>；endpoint 要写带 scheme 的 URL，
# v2.7.0 已改用 aws-sdk-go-v2，旧的 usessl 配置项不存在了。
VIKUNJA_S3_ENDPOINT=http://minio.minio.svc.cluster.local:9000
VIKUNJA_S3_BUCKET=vikunja
VIKUNJA_S3_REGION=us-east-1

# 密钥对象名必须是 <APP_NAME>-secrets，deploy-k8s.sh 按这条规则创建。
# 注意与迁移前手工建的 Secret 名不同（那时叫 vikunja-secret）；旧对象在迁移完成后删除。
VIKUNJA_SECRET_NAME=vikunja-secrets

# 容器以 uid/gid 1000 运行（镜像默认），与迁移前保持一致。
VIKUNJA_FS_UID=1000

# 资源上限：与迁移前手工部署一致（申请 100m/128Mi，上限 500m/512Mi）。
VIKUNJA_CPU_LIMIT=500m
VIKUNJA_MEM_LIMIT=512Mi
