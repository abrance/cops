# new-api 的非敏感期望状态（随仓库提交）
#
# 敏感信息不放这里：POSTGRES_PASSWORD / SQL_DSN / REDIS_PASSWORD / SESSION_SECRET
# 走 cloud2 的 /opt/cops/secrets/new-api.env（权限 600，不入库），部署脚本自动加载。

# 镜像：docker.io（default 主机白名单内）。上游**没有**发布 v1.0.0-rc.51 之类的 docker tag，
# docker.io 只有 latest，因此固定到 latest 当时的 digest（= rc.51 构建，2026-11-13）；
# 升级时改 digest：docker pull 新版本后看 `docker image inspect --format '{{index .RepoDigests 0}}'`。
NEW_API_IMAGE=calciumion/new-api
NEW_API_IMAGE_TAG=latest@sha256:d6effcdbc58175494765c0cc5954bdacb2300516eec79ba1a9c61f9b9fae7b49

# 上游官方 compose 用 postgres:15；这里跟它一致，降级/迁移路径最少
NEW_API_DB_IMAGE=postgres
NEW_API_DB_IMAGE_TAG=15-alpine

NEW_API_REDIS_IMAGE=redis
NEW_API_REDIS_IMAGE_TAG=7-alpine

# 宿主机回环端口（litellm 已下线，沿用 4000，domino/traefik 的反代指向不用改）
NEW_API_PORT=4000

TZ=Asia/Shanghai
