# pg（k8s）：cloud3 上的 Postgres 17 单副本单元。
#
# 为什么单独成单元：pg-test 命名空间里的实例是 46 天前手搓的试验品，不在 Git 里，
# 于是同时踩了三个坑——数据落在容器匿名卷上（PGDATA 不在 PVC）、没有备份、
# 用 IngressRouteTCP + Traefik pg 入口把 5432 暴露到公网 30630。三者的根因是
# 「不在 GitOps 里」，所以本单元取代它，而不是给旧实例打补丁。
#
# 口令不放这里：POSTGRES_PASSWORD（超级用户）与 LLMBM_DB_PASSWORD（应用角色）
# 走 SECRET_ENV + GitHub Secrets，由 CI 下发成命名空间 Secret pg-secrets。

# 镜像源：cloud3 只能直连 docker.io（ghcr.chenby.cn 会被 Cloudflare 拦 403）
PG_IMAGE=docker.io/library/postgres:17

# 一次给够：local-path 的 StorageClass 没开 allowVolumeExpansion（集群级 SC，
# 改它会影响所有单元），PVC 建好之后不能扩容，所以首建就按 10Gi 给。
PG_DATA_SIZE=10Gi

# 资源：pg-test 上现役实例实测 19m CPU / 71Mi 内存，但那是几乎空转的状态。
# 这里给 200m/512Mi 请求（shared_buffers 默认 128MB + 并发连接 + 崩溃重启余量）、
# 1 核 / 1Gi 上限。上限刻意不压到 500m —— 那会是第一个瓶颈，而节点有 16 核。
PG_CPU_REQUEST=200m
PG_MEM_REQUEST=512Mi
PG_CPU_LIMIT=1000m
PG_MEM_LIMIT=1Gi

# 超级用户与实例级库名（非敏感，随仓库走）
POSTGRES_USER=xiaoy
POSTGRES_DB=postgres

# 应用库与角色（llmbm 专用）。角色在建库首次初始化时创建，非 superuser、非 createdb。
LLMBM_DB_NAME=llmbm
LLMBM_DB_USER=llmbm
PG_PORT=5432

# ── 备份 ────────────────────────────────────────────────────────────────
# 每天 03:00（上海时间）pg_dump -Fc → MinIO，保留 14 天；每周日另复制一份到
# 宿主机 /opt/cops/backup/pg/ 保留 4 周；每次都再传一份到 NAS（另一台物理机）。
#
# 失效域：MinIO 的数据目录是 hostPath /opt/minio/data，与 PG 的 PVC 同在
# cloud3 的 /dev/vda1（mountinfo 实测），宿主机那份也在同一块盘。所以
# MinIO + 宿主机目录只能扛「误删库 / 误删 PVC / 重建命名空间」，
# 真正能扛盘坏/宿主机丢的只有 NAS 那一份。
PG_BACKUP_SCHEDULE=0 3 * * *
PG_BACKUP_TZ=Asia/Shanghai
# 备份里要 mc（MinIO 客户端）。官方 minio/mc 在 docker.io 与 quay.io 上都已不可匿名拉取
# （实测 401 / pull access denied），bitnamilegacy 这个镜像自带 mc 且 cloud3 能拉。
PG_BACKUP_IMAGE=docker.io/bitnamilegacy/minio:2025.7.23-debian-12-r5
# bucket 名不能少于 3 字符（MinIO 限制）：用 pg-backup，不用 pg
PG_BACKUP_BUCKET=pg-backup
PG_BACKUP_KEEP_DAYS=14
# 宿主机那份保留 4 周（28 天）；下个周日备份成功后清掉 28 天前的文件
PG_BACKUP_HOST_KEEP_DAYS=28
# ── 异地副本（NAS 10.193.0.5，easytier mesh）──────────────────────────
# 目标端容量实测：/pool1_8t 13T 可用 13T（1% 已用），目录已建。
# 走 NAS 上已存在的 xiaoy 账号 + 专用 ed25519 密钥（注释 cops-pg-offsite）；
# 私钥与 NAS 主机指纹在 cloud3 的 /opt/cops/backup/pg-offsite-ssh/（700，不进 git）。
# 每天的 dump（~3KiB）与 globals 都传，按份数保留 14 份。
PG_BACKUP_OFFSITE_HOST=xiaoy@10.193.0.5
PG_BACKUP_OFFSITE_DIR=/pool1_8t/public/backup/pg
PG_BACKUP_OFFSITE_KEEP=14
# 异地容器要 ssh/scp/sha256sum：MinIO 那个镜像里没有 ssh（实测），单独用一个
# 带 openssh 的小镜像。cloud3 实测能拉（instrumentisto/rsync-ssh:latest，6.9MB）。
PG_BACKUP_OFFSITE_IMAGE=docker.io/instrumentisto/rsync-ssh:latest
MINIO_ENDPOINT=http://minio.minio.svc.cluster.local:9000

TZ=Asia/Shanghai
