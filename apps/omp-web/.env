# omp-web 的非敏感期望状态（随仓库提交）
#
# 敏感信息不要写在这里。运行期密钥放到云主机 /opt/cops/secrets/omp-web.env
# （权限 600，不入库），由 CI 下发，再由 scripts/deploy-k8s.sh 变成 k8s Secret
# 注入容器（见 app.conf 的 SECRET_ENV 与 README「k8s 部署模式」）。
#
# 源码仓库：https://github.com/abrance/omp-box —— 第二个工作台（omp 实例）的镜像：
# omp-web（进程内跑 omp 自己的 SDK）+ 出厂基线对账 + 冒烟。
# 设计与取舍在 https://github.com/abrance/modelman 的 docs/omp-instance.md。
#
# 与主工作台（model-agent）的关系：独立镜像、独立基线、独立卷、独立单元；
# 只共享约定（cops 单元、密钥管道、域名与证书）与**同一个入口密码值**。
#
# 镜像 tag 约定：<版本>-<提交短 sha>，永不覆盖。tag 由 omp-image workflow 的
# job summary 给出（打 omp/vX.Y.Z 触发）。
#
# v0.2.0-9072bad：基线加 deepseek provider（https://new.9-u.cn/v1 的
# deepseek-v4.1-flash）。注意启动对账对「卷上 == 上次基线」的 models.yml 是**覆盖**
# 语义，所以只在面板里加的 provider 活不过 Pod 重建——能留住的必须进基线。
#
# 镜像源：cloud3 用 ghcr.io 直连（旧镜像站会被 Cloudflare 拦，见 docs/knowledge.md 第 6 节）。
# 镜像是公开包，不需要凭据。
AGENT_IMAGE=ghcr.io/abrance/omp-web
AGENT_IMAGE_TAG=v0.2.0-9072bad

# 公网入口域名（k8s.yaml 的两条 IngressRoute 用它）：DNS 里 omp.xiaoyxq.top
# 已指向 cloud3，证书由 Traefik 的 ACME 自动签发。改域名要同时改下面的
# AGENT_ALLOWED_HOSTS —— 两个地方必须是同一个值，否则请求会被判成不可信（403）。
PUBLIC_HOST=omp.xiaoyxq.top

# 容器监听端口：镜像默认 30141，这里统一到集群惯用的 8080
# （同时用作 Service 端口、探针端口与 deploy-k8s.sh 的 K8S_HEALTH 端口）。
AGENT_PORT=8080

# 反代白名单：omp-web 默认只信任回环、IP 字面量与显式列出的主机；走 Traefik 反代
# 时必须列出对外域名，否则非 loopback 的 Host 一律 403（实测过，见 omp-instance.md）。
AGENT_ALLOWED_HOSTS=omp.xiaoyxq.top

# 卷容量：agent 目录（session、agent.db、models.db）+ HOME + 工作目录都在 /data 上
AGENT_PVC_SIZE=4Gi

# 密钥对象的名称约定：必须等于 <APP_NAME>-secrets，deploy-k8s.sh 按这个规则创建。
AGENT_SECRET_NAME=omp-web-secrets

# ── 资源上限 ─────────────────────────────────────────────────────────────────
#
# 首版估值，不是实测：镜像是 Next.js 服务端 + omp SDK（TS 源码，跑在 Bun 上），
# 空载预计 300–600 MiB，一次会话跑起来还会涨。上限对齐主工作台但留更多余量
# （omp SDK 比 pi 大）。CPU 给 2 核：会话是等 provider 的网络 IO，不占 CPU。
AGENT_CPU_LIMIT=2
AGENT_MEM_LIMIT=2Gi
