# model-ocr 的非敏感期望状态（随仓库提交）
#
# 敏感信息不要写在这里。如需运行期密钥，放到云主机
# /opt/cops/secrets/model-ocr.env（权限 600，不入库），部署脚本会自动加载。
#
# 源码仓库：https://github.com/abrance/modelman
# 镜像 tag 约定：<版本>-<提交短 sha>，永不覆盖。改 tag 前先确认该 tag 已在
# modelman 的 release job summary 中给出。

# 镜像源：cloud3 用 ghcr.io 直连（旧的 ghcr.chenby.cn 从 cloud3 访问会被 Cloudflare
# 拦成 403，见 docs/knowledge.md 第 6 节）。镜像是公开包，不需要凭据。
MODEL_OCR_IMAGE=ghcr.io/abrance/modelman-ocr
MODEL_OCR_IMAGE_TAG=v0.1.3-6476ffb

# 公网入口域名（k8s.yaml 的两条 IngressRoute 用它）：DNS 里 ocr.xiaoyxq.top
# 已指向 cloud3，证书由 Traefik 的 ACME 自动签发。
PUBLIC_HOST=ocr.xiaoyxq.top

# 端口：k8s 里没有"宿主机端口"这回事，这里指**容器监听端口**（镜像固定 8080），
# 同时用作 Service 端口与探针端口。旧 compose 版的 9101 是宿主机端口，已作废。
MODEL_OCR_PORT=8080

# 识别档位。v6small 为实测最优，v6tiny 更快但漏识明显，v5 仅用于输出兼容。
# 详见 https://github.com/abrance/modelman/blob/main/docs/ocr-model-selection.md
MODEL_OCR_DEFAULT_MODEL=v6small
MODEL_OCR_PRELOAD_MODELS=v6small

# 低于该置信度的识别行会被丢弃
MODEL_OCR_CONF_THRESHOLD=0.3

# 推理并发上限。云主机 4 核且与 lems/ptdoc/qdrant/postgres 共享，
# 这两个值必须显式设置，不能留给运行时按核数推导。
MODEL_OCR_MAX_CONCURRENCY=2
MODEL_OCR_OMP_NUM_THREADS=2

# 长边上限像素。0 表示不缩放：缩图会抹掉小字号文本，仅在必要时开启。
MODEL_OCR_MAX_SIDE=0

# 日志级别
# 注意：ocr_service=info 只保留服务自身日志，tower_http 的访问日志默认会被整体过滤掉；
# 加上 tower_http=debug 后每个请求会产生 on_request / on_response 两行，
# 形如 DEBUG request{method=POST uri=/ocr}: finished processing request latency=28 ms status=200。
# 前一代实现（kuba 的 access log middleware）就是逐请求记录，这里保持等价能力。
# 容器日志轮转为 20m x 3，健康检查每 30s 一次，日常量级不会写满磁盘。
MODEL_OCR_RUST_LOG=ocr_service=info,tower_http=debug

# 资源上限。实测常驻内存约 65 MB，此处是兜底而非预期用量。
MODEL_OCR_CPU_LIMIT=2.0
# k8s 用 Mi 单位（数值与旧 compose 版的 1500M 一致）
MODEL_OCR_MEM_LIMIT=1500Mi

# 暴露方式：暴露面由 k8s 对象决定 —— Service 是 ClusterIP（集群内可达），
# 公网入口是 k8s.yaml 里的两条 IngressRoute（ocr.xiaoyxq.top → Service:8080），
# TLS 由 k3s 自带 Traefik 的 ACME 自动签发。旧 compose 版"只绑回环 + 宿主机反代"
# 在 k8s 里没有对应物。
#
# 迁移带来的口径变化：**服务现在真的能从公网调到**（之前只有同机 lems 能访问）。
# 这是迁移时明确接受的取舍（见 docs/cloud3-k8s-cd-design.md 第 8 节）。
#
# 鉴权口径：**当前不启用**，入口挂上即可用（决定见 modelman 仓库 docs/design.md D15）。
# 也就是说任何能访问入口的人都能调 /ocr，消耗共享主机的 CPU；影响面由
# MODEL_OCR_MAX_CONCURRENCY / QUEUE_TIMEOUT_SECS 与下面的 cpus/memory 限额卡住，
# 被滥用时表现为对方拿到 503，而不是把主机拖垮。
#
# 要收敛时改三处即可，**不需要改服务代码**（服务端与页面的 token 逻辑都已实现）：
#   1. .github/workflows/deploy.yml 的密钥分发映射里加一行 MODEL_OCR_AUTH_TOKEN
#   2. app.conf 的 SECRET_ENV 改成 "AUTH_TOKEN"，并在 REQUIRED_ENV 里同步声明
#   3. token 写入目标主机 /opt/cops/secrets/model-ocr.env（权限 600）
# k8s 补充：还需要把它以 Secret 形式注入容器（当前 AUTH_TOKEN 从 .env 渲染，
# 只适合空值；见 README「k8s 部署模式」）
AUTH_TOKEN=
