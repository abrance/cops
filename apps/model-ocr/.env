# model-ocr 的非敏感期望状态（随仓库提交）
#
# 敏感信息不要写在这里。如需运行期密钥，放到云主机
# /opt/cops/secrets/model-ocr.env（权限 600，不入库），部署脚本会自动加载。
#
# 源码仓库：https://github.com/abrance/modelman
# 镜像 tag 约定：<版本>-<提交短 sha>，永不覆盖。改 tag 前先确认该 tag 已在
# modelman 的 release job summary 中给出。

# 镜像源：ghcr.chenby.cn，tag 使用具体版本
MODEL_OCR_IMAGE=ghcr.chenby.cn/abrance/modelman-ocr
MODEL_OCR_IMAGE_TAG=v0.1.0-e12648f

# 端口：模型服务统一使用 91xx 段（11000/1502/4173/8081/9090 已被占用）
MODEL_OCR_PORT=9101

# 识别档位。v6small 为实测最优，v6tiny 更快但漏识明显，v5 仅用于输出兼容。
# 详见 https://github.com/abrance/modelman/blob/main/docs/ocr-model-selection.md
MODEL_OCR_DEFAULT_MODEL=v6small
MODEL_OCR_PRELOAD_MODELS=v6small

# 低于该置信度的识别行会被丢弃
MODEL_OCR_CONF_THRESHOLD=0.3

# 推理并发上限。云主机 4 核且与 lems/ptdoc/qdrant/postgres 共享，
# 这两个值必须显式设置，不能留给运行时按核数推导。
MODEL_OCR_MAX_CONCURRENCY=2
MODEL_OCR_OMP_NUM_THREADS=2

# 长边上限像素。0 表示不缩放：缩图会抹掉小字号文本，仅在必要时开启。
MODEL_OCR_MAX_SIDE=0

# 资源上限。实测常驻内存约 65 MB，此处是兜底而非预期用量。
MODEL_OCR_CPU_LIMIT=2.0
MODEL_OCR_MEM_LIMIT=1500M

# 暴露方式：本单元只绑回环（127.0.0.1:9101），公网入口由宿主机上的
# dockpanel/traefik 转发，不在本仓库范围。
#
# 注意：服务默认没有账号体系。如果那个入口对公网开放，必须先给服务加上 token，
# 否则等于把 CPU 密集型接口免费对外开放。三步：
#   1. .github/workflows/deploy.yml 的密钥分发映射里加一行 MODEL_OCR_AUTH_TOKEN
#   2. app.conf 的 SECRET_ENV 改成 "AUTH_TOKEN"，并在 REQUIRED_ENV 里同步声明
#   3. token 写入云主机 /opt/cops/secrets/model-ocr.env（权限 600）
AUTH_TOKEN=
