# model-forecast 的非敏感期望状态（随仓库提交）
#
# 敏感信息不要写在这里。如需运行期密钥，放到云主机
# /opt/cops/secrets/model-forecast.env（权限 600，不入库），部署脚本会自动加载。
#
# 源码仓库：https://github.com/abrance/modelman
# 镜像 tag 约定：<版本>-<提交短 sha>，永不覆盖。改 tag 前先确认该 tag 已在
# modelman 的 release job summary 中给出。
#
# ⚠️ 许可证：这个服务带的是 **非商业** 权重（timesfm-non-commercial-license-v1.0，
#    代码是 Apache-2.0）。当前用途是自用与评估；要做生产/商业用途就得先换整档权重
#    （TimesFM 2.5 是 Apache-2.0）或取得授权。见 modelman 仓库
#    registry/forecast.yaml 的 license 一节。

# 镜像源：cloud3 用 ghcr.io 直连（旧的 ghcr.chenby.cn 从 cloud3 访问会被 Cloudflare
# 拦成 403，见 docs/knowledge.md 第 6 节）。镜像是公开包，不需要凭据。
MODEL_FORECAST_IMAGE=ghcr.io/abrance/modelman-forecast
# 镜像 tag 来自 modelman 的 release forecast/v0.1.0（release job summary 给出）
# 格式为 v0.1.0-<7 位提交短 sha>。
# 镜像不存在时部署会停在「拉取镜像」，升级 tag 前先确认新 tag 已在镜像站可拉取。
MODEL_FORECAST_IMAGE_TAG=v0.1.0-0000000

# 公网入口域名（k8s.yaml 的两条 IngressRoute 用它）：DNS 里 forecast.xiaoyxq.top
# 已指向 cloud3，证书由 Traefik 的 ACME 自动签发。改域名只需改这一行。
#
# 顺序不能反（docs/cloud3.md 第四节）：**先加 DNS A 记录再 apply**。反过来就是
# ACME 的 HTTP-01 挑战 404 失败，会撞 Let's Encrypt 限流
# （同域名每小时 5 次失败 / 每周 5 张重复证书）。
PUBLIC_HOST=forecast.xiaoyxq.top

# 端口：k8s 里没有"宿主机端口"这回事，这里指**容器监听端口**（镜像固定 8080），
# 同时用作 Service 端口与探针端口。9102 是 modelman 文档里给这个服务预留的编号，
# 那是本地 `make run` 用的，不是 k8s 端口。
MODEL_FORECAST_PORT=8080

# ── 模型与推理 ───────────────────────────────────────────────────────────────
#
# 权重随镜像交付（1.32 GB），这几个值是纯运行期参数，不是状态的一部分：
# 改它们不会让旧数据失效，只会改变单次预测的耗时与内存。

# 唯一档位。TimesFM 3.0 与 2.5 是两套权重与 API，同时常驻要双份内存。
MODEL_FORECAST_MODEL_TIER=timesfm-3.0
MODEL_FORECAST_DEVICE=cpu
# torch 的 intra-op 线程数。**它同时是内存上界的一部分**：同样的权重，16 线程下
# 的峰值 RSS 明显高于 4 线程（OpenMP/MKL 每线程 arena）。调大前先看常驻内存。
MODEL_FORECAST_INFER_THREADS=4
# 启动即加载权重：容器就绪前就把 1.32 GB 读完，避免第一个请求承担加载延迟
MODEL_FORECAST_PRELOAD=true
# 加载前逐文件核 sha256。1.32 GB 的校验约几秒，换的是"权重文件在盘上被换掉/
# 截断"这类问题不会静默给出错误结果。
MODEL_FORECAST_VERIFY_WEIGHTS=true

# ── 输入上限 ─────────────────────────────────────────────────────────────────
#
# 时序预测的耗时与激活内存随上下文长度和步长增长，三个上限都必须显式声明。
# 超长上下文不报错而是取最后一段（响应里 truncated=true，指标里也有计数器）。

# 模型自身上限是 15360 个点，这里收到 4096：全用满时单次前向的时间和内存都难以预测
MODEL_FORECAST_MAX_CONTEXT=4096
MODEL_FORECAST_MAX_HORIZON=512
# 单请求序列条数：批内是顺序前向，条数越多占用并发槽位越久
MODEL_FORECAST_MAX_SERIES=16
# 16 条 × 4096 点按 JSON 文本算约 0.5 MB，留一倍余量
MODEL_FORECAST_MAX_BYTES=2097152

# ── 并发 ─────────────────────────────────────────────────────────────────────
#
# 云主机是与邻居共享的，这几个值必须显式设置，不能留给运行时按核数推导。
# 一次预测要吃满几个核，请求堆积比快速失败更糟：等不到槽位就 503。
MODEL_FORECAST_MAX_CONCURRENCY=2
MODEL_FORECAST_QUEUE_TIMEOUT_SECS=60
# uvicorn 连接级上限，超出直接 503，避免排队无界
MODEL_FORECAST_LIMIT_CONCURRENCY=8

MODEL_FORECAST_LOG_LEVEL=info

# ── 资源 ─────────────────────────────────────────────────────────────────────
#
# 内存：实测常驻约 1.5 GB、加载峰值 2.8 GB（4 线程），所以上限必须 >= 3Gi。
# 给 1.5Gi 会在加载阶段被 OOM 杀掉，现象是 Pod 反复重启而 /readyz 永远 503。
MODEL_FORECAST_MEM_LIMIT=3Gi
# CPU：limit 给 2 是为了让单次预测能跑到 4 线程（约 1.3 秒/512 点×48 步）；
# request 刻意只给 500m —— 别的单元都只写 limits，k8s 会把 request 默认成 limit，
# 于是 node 上 16 核已经被 request 掉 14.22 核，这个单元按 limit 申请就会
# Pending（实测过：加 2 核 request 直接 Insufficient cpu）。
MODEL_FORECAST_CPU_LIMIT=2
MODEL_FORECAST_CPU_REQUEST=500m
MODEL_FORECAST_MEM_REQUEST=1Gi

# ── 暴露方式与鉴权 ───────────────────────────────────────────────────────────
#
# 暴露面由 k8s 对象决定：Service 是 ClusterIP（集群内可达），公网入口是 k8s.yaml
# 里的两条 IngressRoute（forecast.xiaoyxq.top → Service:8080），TLS 证书由 k3s
# 自带 Traefik 的 ACME 自动签发。
#
# 鉴权口径：**当前不启用**，与 model-ocr / model-logcluster 同
# （modelman 仓库 docs/design.md D16）。代价：/v1/forecast 是计算接口，
# 入口对外可达时任何人都能打；服务的输入上限与并发上限就是唯一的护栏。
#
# 要收敛时改三处即可，不需要改服务代码（服务端 token 逻辑已实现并有测试）：
#   1. .github/workflows/deploy.yml 的密钥分发映射里加一行 MODEL_FORECAST_AUTH_TOKEN
#   2. app.conf 的 SECRET_ENV 改成 "AUTH_TOKEN"，并在 REQUIRED_ENV 里同步声明
#   3. token 写入目标主机 /opt/cops/secrets/model-forecast.env（权限 600）
AUTH_TOKEN=
