# model-jev 的非敏感期望状态（随仓库提交）
#
# 敏感信息不要写在这里。如需运行期密钥，放到云主机
# /opt/cops/secrets/model-jev.env（权限 600，不入库），部署脚本会自动加载。
#
# 源码仓库：https://github.com/abrance/modelman
# 镜像 tag 约定：<版本>-<提交短 sha>，永不覆盖。改 tag 前先确认该 tag 已在
# modelman 的 release job summary 中给出。
#
# 服务是什么：System One 风格的 typed decisions（choice / noul / score），
# 一次前向返回全部答案与概率，不生成文本。对外协议与 TypeSafe Jev 同形状
# （POST /v1/systemone），调用方 pi-jev 只需要指向这个入口，不用改代码。

# 镜像源：cloud3 用 ghcr.io 直连（旧的 ghcr.chenby.cn 从 cloud3 访问会被 Cloudflare
# 拦成 403，见 docs/knowledge.md 第 6 节）。镜像是公开包，不需要凭据。
MODEL_JEV_IMAGE=ghcr.io/abrance/modelman-jev
# 镜像 tag 来自 modelman 的 release jev/v0.1.0（release job summary 给出）
# 格式为 v0.1.0-<7 位提交短 sha>。
# 镜像不存在时部署会停在「拉取镜像」，升级 tag 前先确认新 tag 已在镜像站可拉取。
MODEL_JEV_IMAGE_TAG=v0.1.0-79e8653

# 公网入口域名（k8s.yaml 的两条 IngressRoute 用它）：DNS 里 jev.xiaoyxq.top
# 已指向 cloud3，证书由 Traefik 的 ACME 自动签发。改域名只需改这一行。
#
# 顺序不能反（docs/cloud3.md 第四节）：**先加 DNS A 记录再 apply**。反过来就是
# ACME 的 HTTP-01 挑战 404 失败，会撞 Let's Encrypt 限流
# （同域名每小时 5 次失败 / 每周 5 张重复证书）。
PUBLIC_HOST=jev.xiaoyxq.top

# 端口：k8s 里没有"宿主机端口"这回事，这里指**容器监听端口**（镜像固定 8080），
# 同时用作 Service 端口与探针端口。9104 是 modelman 文档里给这个服务预留的编号，
# 那是本地 `make run` 用的，不是 k8s 端口。
MODEL_JEV_PORT=8080

# ── 模型与推理 ───────────────────────────────────────────────────────────────
#
# 权重随镜像交付（678 MB），这几个值是纯运行期参数，不是状态的一部分。

# 唯一档位：multilingual（mmBERT-base，322M，覆盖 100+ 语言含英文）。
# 不带 english 档位是有意的：两个 checkpoint 都常驻会让内存从 1.7 GB 涨到 2.4 GB 以上，
# 而收益只在纯英文场景（见 modelman 仓库 docs/design.md D19）。
MODEL_JEV_MODEL_TIER=multilingual
MODEL_JEV_DEVICE=cpu
# torch 的 intra-op 线程数。**必须显式设置**：cloud3 是共享 vCPU，实测给满 16 线程时
# 单问延迟从 207 ms 涨到 2165 ms（互相踩的代价比并行收益大一个数量级）。
# 4 线程实测：单问 207 ms、三问 890 ms。
MODEL_JEV_INFER_THREADS=4
# 启动即加载权重：容器就绪前把 678 MB 读完（实测 9.7 秒），避免第一个请求承担加载延迟
MODEL_JEV_PRELOAD=true

# ── 输入上限 ─────────────────────────────────────────────────────────────────
#
# state 与选项都要过 tokenizer，超长输入的时间和内存都难以预测，四处上限都要显式声明。
# state 超出 token 预算时响应里 truncated=true，调用方应当据此拒绝采用答案。

# state 与选项的 token 预算。1024 是上游对 multilingual 的默认值（上限 8192）
MODEL_JEV_MAX_LEN=1024
MODEL_JEV_HEAD_MAX_LEN=256
# state 字符上限（对象会先序列化再算）
MODEL_JEV_MAX_STATE_CHARS=8000
MODEL_JEV_MAX_QUESTIONS=32
# 与上游 serve 的上限一致（超出它直接 413）
MODEL_JEV_MAX_OPTIONS=100
# 判定请求很小：32 问题 × 100 选项的 JSON 也在 100 KB 量级，留十倍余量
MODEL_JEV_MAX_BYTES=1048576

# ── 并发 ─────────────────────────────────────────────────────────────────────
#
# 云主机是与邻居共享的，这几个值必须显式设置，不能留给运行时按核数推导。
# 一次判定要吃满 4 个核几百毫秒，请求堆积比快速失败更糟：等不到槽位就 503。
MODEL_JEV_MAX_CONCURRENCY=2
MODEL_JEV_QUEUE_TIMEOUT_SECS=30
# uvicorn 连接级上限，超出直接 503，避免排队无界
MODEL_JEV_LIMIT_CONCURRENCY=8

MODEL_JEV_LOG_LEVEL=info

# ── 资源 ─────────────────────────────────────────────────────────────────────
#
# 内存：实测常驻 1.70 GB、加载峰值 2.30 GB（4 线程），所以上限必须 >= 3Gi。
# 给 1.5Gi 会在加载阶段被 OOM 杀掉，现象是 Pod 反复重启而 /readyz 永远 503。
MODEL_JEV_MEM_LIMIT=3Gi
# CPU：limit 给 4 与 INFER_THREADS=4 对齐（给 2 会让 4 个线程互相等核）。
# request 刻意只给 500m：别的单元只写 limits，k8s 会把 request 默认成 limit，
# 于是 node 上 16 核被 request 掉十多个，这个单元按 limit 申请就会 Pending。
MODEL_JEV_CPU_LIMIT=4
MODEL_JEV_CPU_REQUEST=500m
MODEL_JEV_MEM_REQUEST=1Gi

# ── 暴露方式与鉴权 ───────────────────────────────────────────────────────────
#
# 暴露面由 k8s 对象决定：Service 是 ClusterIP（集群内可达），公网入口是 k8s.yaml
# 里的两条 IngressRoute（jev.xiaoyxq.top → Service:8080），TLS 证书由 k3s 自带
# Traefik 的 ACME 自动签发。
#
# 鉴权口径：**这个单元与其它单元不同，默认启用 AUTH_TOKEN**。理由是调用的性质：
# /v1/systemone 是计算接口，入口对外可达时任何人都能打；而调用方 pi-jev 恒定发送
# `Authorization: Bearer <TYPESAFE_API_KEY>`，服务端 AUTH_TOKEN 校验的就是它——
# 也就是说启用鉴权对调用侧是零改动（modelman 仓库 services/jev/README.md）。
# 其它单元为什么不开、以后怎么统一，见 modelman 仓库 docs/design.md D15–D17 与
# 本仓库 README；这里只记本单元的取值：AUTH_TOKEN 由密钥文件提供（SECRET_ENV）。
# Secret 名：deploy-k8s.sh 用主机上的密钥文件生成这个 Secret，manifest 通过
# envFrom.secretRef 引用它（README「k8s 部署模式」）。
MODEL_JEV_SECRET_NAME=model-jev-secrets

# AUTH_TOKEN 的**值**不在这里，也不进仓库：来源是 GitHub Secret MODEL_TOKEN，
# 由 deploy.yml 映射成分发变量 AUTH_TOKEN（容器侧只认这个名字），CI 再写到主机
# /opt/cops/secrets/model-jev.env（权限 600），最后由 deploy-k8s.sh 变成上面的
# Secret 注入容器。取值必须与 pi-jev 侧的 TYPESAFE_API_KEY 一致。
